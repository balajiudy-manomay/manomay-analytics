# Company Branding
NEXT_PUBLIC_COMPANY_NAME="Manomay Analytics"

# ==============================================================================
# SHAREPOINT ACCESS-CONTROL WORKBOOK (primary source of users + report access)
# ==============================================================================

# Azure AD app registration used for app-only (client-credentials) Microsoft
# Graph calls. Needs Graph application permission Sites.Read.All or
# Files.Read.All (or ReadWrite variants), admin-consented.
AZURE_TENANT_ID="<tenant-id>"
AZURE_CLIENT_ID="<app-registration-client-id>"
AZURE_CLIENT_SECRET="<app-registration-client-secret>"

# The "Copy link" share URL of the access-control.xlsx workbook in SharePoint.
SHAREPOINT_FILE_URL="https://<tenant>.sharepoint.com/:x:/s/<site>/<encoded-id>?e=<code>"

# How long the parsed workbook is cached in memory before re-fetching, in
# seconds. Defaults to 1800 (30 minutes) if unset. Access/role changes made
# in the sheet take up to this long to take effect.
SHAREPOINT_CACHE_TTL_SECONDS="1800"

# The SharePoint workbook (Users sheet + one sheet per role) is the ONLY
# source of login accounts and report access - there is no env-var fallback.
# If SHAREPOINT_FILE_URL is missing or unreachable, login and the dashboard
# fail outright rather than silently falling back to local data.
