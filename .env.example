# Company Branding
NEXT_PUBLIC_COMPANY_NAME="Manomay Analytics"

# USERS: every login, as comma-separated "email:password:role" triples.
USERS="alice@manomay.biz:changeme1:admin,bob@manomay.biz:changeme2:viewer"

# ROLE_REPORTS: each role's allowed report keys, as comma-separated
ROLE_REPORTS="admin:[resource-utilization:resource-utilization-without-cost:revenue-tracking:timesheets-tracking:contracts-tracking:status-updates:project-budget-tracking],viewer:[status-updates]"

# ==============================================================================
