# Power BI Dashboard Viewer Configuration Example

# Power BI Embed URL (Required)
# Supports: Publish to Web URLs, Secure Embed URLs, Normal Report URLs, Power BI App URLs, Report Server URLs
VITE_POWERBI_EMBED_URL="https://app.powerbi.com/view?r=YOUR_EMBED_URL_HERE"

# Embedding Strategy Strategy: 'auto' | 'iframe' | 'secure-iframe' | 'sdk-user' | 'sdk-app'
VITE_POWERBI_EMBED_MODE="auto"

# Domain Allowlist (Comma-separated hostnames permitted for iframe/SDK embedding)
VITE_POWERBI_ALLOWED_HOSTS="app.powerbi.com,playground.powerbi.com,app.powerbigov.us"

# Microsoft Entra ID (Azure AD) Scaffolding for SDK / User Authentication
VITE_AZURE_CLIENT_ID=""
VITE_AZURE_TENANT_ID=""

# Company Branding
VITE_COMPANY_LOGO="/logo.svg"
VITE_COMPANY_NAME="Company Name"
