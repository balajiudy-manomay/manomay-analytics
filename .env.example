# Power BI Dashboard Viewer Configuration Example

# Power BI Embed URL (Required)
# Paste your Power BI publish to web URL or embed link here.
VITE_POWERBI_EMBED_URL="https://app.powerbi.com/view?r=YOUR_EMBED_URL_HERE"

# Company Logo Path (Loaded from public folder or URL)
# Put your logo image (e.g. logo.png or logo.svg) in the 'public' folder and reference it here.
VITE_COMPANY_LOGO="/logo.svg"

# Optional Company Name / App Title
VITE_COMPANY_NAME="Company Name"
