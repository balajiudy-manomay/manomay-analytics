# USERS: every login, as comma-separated "email:password:role" triples.
# Parsed on the email's FIRST ":" and the entry's LAST ":", so passwords may
# contain ":" (role names must not). No "," inside a password or role.
USERS="alice@manomay.biz:changeme1:admin,bob@manomay.biz:changeme2:viewer"

# ROLE_REPORTS: each role's allowed report keys, as comma-separated
# "role:[key:key:key]" entries. Valid keys: resource-utilization,
# resource-utilization-without-cost, revenue-tracking, timesheets-tracking,
# contracts-tracking, status-updates.
ROLE_REPORTS="admin:[resource-utilization:resource-utilization-without-cost:revenue-tracking:timesheets-tracking:contracts-tracking:status-updates],viewer:[status-updates]"

# ==============================================================================
# 1. AZURE AD & SERVICE PRINCIPAL CREDENTIALS
# ==============================================================================

# PBI_TENANT_ID: Microsoft Entra ID (Azure AD) Directory / Tenant ID
# - Where: Azure Portal (https://portal.azure.com)
# - How to get it:
#   1. Go to Microsoft Entra ID (Azure Active Directory) > Overview.
#   2. Copy the "Tenant ID" (or from Power BI service: click "?" Help > About Power BI > Tenant ID).
PBI_TENANT_ID="<azure-ad-tenant-id>"

# PBI_CLIENT_ID: Application (client) ID of your Azure App Registration
# - Where: Azure Portal (https://portal.azure.com)
# - How to get it:
#   1. Go to Microsoft Entra ID > App registrations > select or create your App.
#   2. Under the "Overview" section, copy the "Application (client) ID".
PBI_CLIENT_ID="<app-registration-client-id>"

# PBI_CLIENT_SECRET: Client Secret value generated for the App Registration
# - Where: Azure Portal (https://portal.azure.com)
# - How to get it:
#   1. Go to Microsoft Entra ID > App registrations > your App > "Certificates & secrets".
#   2. Click "+ New client secret", add description/expiry, and click "Add".
#   3. Copy the "Value" immediately (Note: it is only shown once; do NOT copy Secret ID).
PBI_CLIENT_SECRET="<app-registration-client-secret>"


# ==============================================================================
# 2. POWER BI WORKSPACE CONFIGURATION
# ==============================================================================

# PBI_WORKSPACE_ID: Power BI Workspace (Group) GUID where the reports reside
# - Where: Power BI Service (https://app.powerbi.com)
# - How to get it:
#   1. Open Power BI Service and navigate to your workspace.
#   2. Look at the browser URL: https://app.powerbi.com/groups/<WORKSPACE_ID>/list
#   3. Copy the GUID right after "/groups/".
#   (Note: Ensure your Azure App / Service Principal is added as a "Member" in Workspace Access,
#    and "Allow service principals to use Power BI APIs" is enabled in Power BI Admin Portal > Tenant Settings).
PBI_WORKSPACE_ID="<power-bi-workspace-id>"


# ==============================================================================
# 3. POWER BI REPORT IDS
# ==============================================================================
# For each report below:
# - Where: Power BI Service (https://app.powerbi.com) inside your workspace
# - How to get it:
#   1. Click to open the specific report in the workspace.
#   2. Look at the browser address bar URL:
#      https://app.powerbi.com/groups/<WORKSPACE_ID>/reports/<REPORT_ID>/ReportSection...
#   3. Copy the GUID between "/reports/" and "/ReportSection" (or query params).

# Report ID: Resource Utilization
PBI_REPORT_ID_RESOURCE_UTILIZATION="<report-id>"

# Report ID: Resource Utilization (Without Cost)
PBI_REPORT_ID_RESOURCE_UTILIZATION_WITHOUT_COST="<report-id>"

# Report ID: Revenue Tracking
PBI_REPORT_ID_REVENUE_TRACKING="<report-id>"

# Report ID: Timesheets Tracking
PBI_REPORT_ID_TIMESHEETS_TRACKING="<report-id>"

# Report ID: Contracts Tracking
PBI_REPORT_ID_CONTRACTS_TRACKING="<report-id>"

# Report ID: Status Updates
PBI_REPORT_ID_STATUS_UPDATES="<report-id>"

# Company Branding — the logo itself is the theme-aware ManomayLogo component
# (src/components/icons/ManomayLogo.tsx), not an env-configurable image.
NEXT_PUBLIC_COMPANY_NAME="Manomay Analytics"
